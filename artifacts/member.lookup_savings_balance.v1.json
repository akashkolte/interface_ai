            "kind": "label_proximity",
            "label_text": "Member ID",
            "control_role": "textbox",
            "direction": "any",
            "label_exact": false
          },
          "fallbacks": [
            {
              "kind": "ordinal",
              "role": "textbox",
              "index": 0
            }
          ],
          "scope": {
            "frame_path": [
              "contentframe"
            ]
          },
          "rationale": "The field has no accessible name (legacy form, no label/for), so proximity to its naming cell is the only stable handle. Ordinal fallback because the search screen has exactly one input."
        },
        "value": "{memberId}"
      },
      "param_bindings": [
        "memberId"
      ],
      "extracts": [],
      "risk": "safe",
      "recovery": [],
      "optional": false
    },
    {
