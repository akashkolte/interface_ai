            {
              "kind": "ordinal",
              "role": "link",
              "index": 0
            }
          ],
          "scope": {
            "frame_path": [
              "contentframe"
            ]
          },
          "rationale": "Address the row by the id we searched for rather than the member's name, which we do not know before the search returns."
        }
      },
      "param_bindings": [
        "memberId"
      ],
      "extracts": [],
