{
  "schema_version": "1.0",
  "capability_id": "member.lookup_savings_balance",
  "version": 1,
  "name": "Read member savings balance",
  "description": "Look up a member by ID and return their current savings balance and status.",
  "goal": "look up member 12345 and read their current savings balance",
