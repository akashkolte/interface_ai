          "primary": {
            "kind": "accessible_name",
            "role": "button",
            "name": "Search",
            "exact": false
          },
          "fallbacks": [],
          "scope": {
            "frame_path": [
              "contentframe"
            ]
          },
          "rationale": "Submit control carries visible text, which the a11y tree exposes as its accessible name; survives restyling."
        }
      },
      "param_bindings": [],
      "extracts": [],
      "checkpoint": {
        "rules": [
          {
            "kind": "text_present",
