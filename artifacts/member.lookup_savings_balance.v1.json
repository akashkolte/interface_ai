          "primary": {
            "kind": "table_cell",
            "row_label": "Name",
            "offset": 1
          },
          "fallbacks": [],
          "scope": {
            "frame_path": [
              "contentframe"
            ]
          },
          "rationale": "Detail grid has no ids; the row label is the only stable key."
        }
      },
      "param_bindings": [],
      "extracts": [
        {
          "output": "memberName",
          "transform": "strip"
        }
      ],
      "risk": "safe",
      "recovery": [],
      "optional": false
    },
    {
      "id": "read_balance",
      "intent": "Read the savings balance",
      "action": {
        "kind": "read",
        "target": {
          "primary": {
            "kind": "table_cell",
            "row_label": "Savings Balance",
            "offset": 1
          },
          "fallbacks": [],
          "scope": {
            "frame_path": [
              "contentframe"
            ]
          },
          "rationale": "Row-label addressing; the label text is tenant-configurable, so relabelled tenants override this descriptor rather than re-record."
        }
      },
      "param_bindings": [],
      "extracts": [
        {
          "output": "savingsBalance",
          "transform": "money"
        }
      ],
      "risk": "safe",
      "recovery": [],
      "optional": false
    }
  ],
